# 应用配置
APP_NAME=AlertMindAgent
ALERT_MIND_DEBUG=True
HOST=0.0.0.0
PORT=9000

# DashScope 配置
# 本地启动前请复制本文件为 .env，并填入 DashScope 控制台生成的新 API Key。
DASHSCOPE_API_KEY=

# Redis 配置
REDIS_URL=redis://localhost:6379
REDIS_CHECKPOINT_TTL_MINUTES=10080
REDIS_CHECKPOINT_REFRESH_ON_READ=true
RAG_STREAM_TERMINAL_TTL_SECONDS=86400
RAG_STREAM_RUNNING_TIMEOUT_SECONDS=7200

# Milvus / MCP / Prometheus 配置
# 本地裸机运行使用 localhost；Docker Compose 生产部署会在 compose 中覆盖为容器服务名。
MILVUS_HOST=localhost
MILVUS_PORT=19531
MCP_MONITOR_URL=http://localhost:8004/mcp
PROMETHEUS_BASE_URL=http://localhost:9090

# LangSmith Trace 配置
# LangSmith SDK 读取进程环境变量；本地启动前请 export 这些变量，
# 或使用 `set -a && source .env && set +a` 后再启动 uvicorn。
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=alert-mind-dev
